name: "Manage Blocked Label"

on:
  pull_request:
    types: [labeled, unlabeled, opened, synchronize, reopened]

jobs:
  enforce-blocked-status:
    name: Check Blocked Status
    runs-on: ubuntu-latest
    permissions:
      pull-requests: write
      
    steps:
      - name: Fail if Blocked
        if: contains(github.event.pull_request.labels.*.name, 'blocked')
        run: |
          echo "::error::This PR is labeled as 'blocked' and cannot be merged until the label is removed."
          exit 1

      - name: Remove 'in-review' when blocked
        if: github.event.action == 'labeled' && github.event.label.name == 'blocked'
        uses: actions/github-script@v7
        with:
          script: |
            try {
              await github.rest.issues.removeLabel({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                name: 'in-review'
              });
            } catch (error) {
              // Ignore error if the label wasn't there to begin with
              if (error.status !== 404) {
                throw error;
              }
            }
